# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.log              # ✅ Catches straggling non-debug logs
*.sqlite           # ✅ In case of embedded dev DBs

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*              # ✅ Safely ignore all env variations

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editor + local config
.vscode/           # ✅ Local editor settings
.idea/             # ✅ JetBrains IDEs
*.swp              # ✅ Vim/VSCode swap files
